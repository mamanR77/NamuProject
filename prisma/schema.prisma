// Namu — Visitor Management System
// Schema dijaga portable: dev = SQLite, prod = PostgreSQL.
// Catatan: SQLite tidak mendukung enum, jadi role/status/channel disimpan sebagai String.
// Daftar nilai yang valid dipusatkan di lib/constants.ts.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Departemen / divisi perusahaan (tempat host bernaung).
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  visits    Visit[]
  createdAt DateTime @default(now())
}

/// Pengguna internal sistem: ADMIN | SECURITY | HOST.
model User {
  id            String         @id @default(cuid())
  name          String
  username      String         @unique
  passwordHash  String
  role          String         @default("HOST") // ADMIN | SECURITY | HOST
  nik           String?        @unique // NIK karyawan (penerima tamu) — kunci validasi konfirmasi selesai
  waNumber      String? // nomor WhatsApp untuk notifikasi (format internasional, mis. 62812...)
  departmentId  String?
  department    Department?    @relation(fields: [departmentId], references: [id])
  hostedVisits  Visit[]        @relation("VisitHost")
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

/// Data tamu (orang yang berkunjung). Bisa berkunjung berkali-kali.
model Visitor {
  id          String   @id @default(cuid())
  fullName    String
  company     String?
  jabatan     String? // jabatan tamu
  phone       String?
  email       String?
  idType      String? // KTP | SIM | PASPOR | KARTU_PEGAWAI
  idNumber    String? // nomor identitas
  idPhoto     String? // foto identitas (data URL base64) - wajib di form
  selfiePhoto String? // foto diri / swafoto (data URL base64)
  photoUrl    String?
  visits      Visit[]
  createdAt   DateTime @default(now())
}

/// Satu sesi kunjungan. Inti dari lifecycle VMS.
/// status: PENDING -> APPROVED -> CHECKED_IN -> CHECKED_OUT (+ REJECTED, EXPIRED)
model Visit {
  id            String         @id @default(cuid())
  visitorId     String
  visitor       Visitor        @relation(fields: [visitorId], references: [id])
  hostId        String? // host terdaftar (di-link/koreksi oleh Security saat review)
  host          User?          @relation("VisitHost", fields: [hostId], references: [id])
  hostName      String? // nama PIC yang diketik tamu (sebelum dikoreksi Security)
  departmentId  String? // departemen tujuan (dipilih tamu)
  department    Department?    @relation(fields: [departmentId], references: [id])
  visitType     String         @default("GENERAL") // GENERAL | LOADING
  loadingType   String? // LOADING | UNLOADING (hanya untuk visitType = LOADING)
  vehicleType   String? // CAR | MOTORCYCLE | NONE
  vehiclePlate  String? // nomor polisi kendaraan
  vehicleBrand  String? // brand/type kendaraan
  driverType    String? // SELF | DRIVER (sendiri / dengan supir)
  driverName    String? // nama supir (jika DRIVER)
  docNumber     String? // No. PO / DO / Surat Jalan (loading)
  detailPurpose String? // detail keperluan
  safetyAgreed  Boolean        @default(false) // komitmen safety & compliance
  purpose       String
  status        String         @default("PENDING_REVIEW")
  cardNo        String? // Nomor Kartu Tamu (Visitor Card), diisi Security saat check-in
  qrToken       String         @unique @default(cuid()) // token untuk badge & scan check-in/out
  reviewedAt    DateTime? // saat Security menyetujui review
  approvedAt    DateTime? // saat kunjungan diterima (karyawan/Warehouse setuju)
  cardIssuedAt  DateTime? // saat Security menerbitkan kartu (barcode aktif)
  rejectedAt    DateTime?
  checkInAt     DateTime? // saat scan masuk di pos (tamu di dalam)
  signedAt      DateTime? // saat penerima tamu konfirmasi selesai (via modul penerima tamu)
  signedName    String? // nama penerima tamu yang konfirmasi
  signedNik     String? // NIK penerima tamu yang konfirmasi
  signatureData String? // tanda tangan (PNG data URL base64)
  checkOutAt    DateTime? // saat scan keluar di pos
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([hostId])
  @@index([visitType])
}

/// Notifikasi ke user (host/security). channel: IN_APP | WA.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  visitId   String?
  visit     Visit?    @relation(fields: [visitId], references: [id])
  channel   String    @default("IN_APP") // IN_APP | WA
  type      String // mis. VISIT_REGISTERED, VISIT_APPROVED, VISIT_CHECKED_IN
  message   String
  status    String    @default("PENDING") // PENDING | SENT | FAILED | READ
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
